# Copy this to .env and fill in your values (never commit .env)

# Gmail address you're sending FROM
GMAIL_SENDER=you@gmail.com

# Gmail App Password — NOT your account password.
# Generate one at: https://myaccount.google.com/apppasswords
# (requires 2FA to be enabled on the account)
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Where to send the digest (defaults to GMAIL_SENDER if omitted)
EMAIL_RECIPIENT=you@gmail.com

# --- Optional tuning ---

# How many top traders to pull per category (default: 10)
TOP_N_TRADERS=10

# Leaderboard time window: DAY | WEEK | MONTH | ALL (default: WEEK)
LEADERBOARD_PERIOD=WEEK
